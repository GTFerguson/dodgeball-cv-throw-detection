# Footage and derived media — obtained via scripts/, never committed (licensing)
data/footage/
data/clips/
data/stress/
*.mp4
*.mkv
*.webm

# Model weights — fetched by scripts/download_weights.py
weights/
*.pt
*.onnx

# Pipeline outputs are regenerated from a clean checkout
output/
runs/

# Environment
.venv/
__pycache__/
*.pyc
.pytest_cache/
.ipynb_checkpoints/

# Local-only
# Session handoffs are agent working-state, not project documentation: local
# paths, in-flight notes, and content the plan docs already carry durably.
docs/plans/handoff/
.scout-browse/
.claude/
.cade/
.nkrdn/
brief.txt
*.pdf

# Pose runs are regenerated by scripts/precompute_pose.py — disposable, never committed
data/pose/

# Court calibration renders are derived from footage; only the fitted JSON is committed
data/court/*_plate.png
data/court/*_overlay.jpg
data/court/*_f[0-9]*.jpg
